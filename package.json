{
  "name": "third-party-analyzer",
  "version": "0.1.1",
  "description": "Quantify what third-party tags cost a page: volume, CPU, TBT and LCP impact, plus the GTM container behind them (with a non-third-party LCP breakdown as a bonus).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "third-party-analyzer": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ideamans/third-party-analyzer.git"
  },
  "license": "MIT",
  "homepage": "https://github.com/ideamans/third-party-analyzer#readme",
  "bugs": "https://github.com/ideamans/third-party-analyzer/issues",
  "keywords": [
    "third-party",
    "tag-manager",
    "gtm",
    "lighthouse",
    "web-performance",
    "lcp"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:binary": "bun build --compile --outfile dist/third-party-analyzer src/cli.ts",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@puppeteer/browsers": "^2.13.0",
    "acorn": "^8.14.0",
    "chrome-launcher": "^1.1.2",
    "lighthouse": "^12.8.2",
    "third-party-web": "^0.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
