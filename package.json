{
  "name": "performance-analyzer",
  "version": "0.0.1",
  "description": "Capture Lighthouse performance traces and analyze them from multiple angles (LCP, third-party tags, GTM).",
  "type": "module",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "performance-analyzer": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "acorn": "^8.14.0",
    "chrome-launcher": "^1.1.2",
    "lighthouse": "^12.8.2",
    "third-party-web": "^0.27.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
